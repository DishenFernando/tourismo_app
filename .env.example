# Copy to .env in the repository root. Do NOT commit real keys.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tourismo:tourismo_dev@db:5432/tourismo
# Set all identity variables together when enabling real Google/email sign-in.
# Values from YOUR Clerk application only.
CLERK_ISSUER=
CLERK_JWKS_URL=
# Optional server-only key: securely sync verified email/name from Clerk. Never use VITE_ prefix.
CLERK_SECRET_KEY=
CLERK_AUDIENCE=
ALLOWED_AUTH_ORIGINS=http://localhost:8000,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=
# Phone OTP intentionally unavailable (no SMS provider configured).
ENABLE_PHONE_OTP=false
# Render sets PORT automatically; local container uses 8000.
PORT=8000
