# Copy to .env in the repository root. Do NOT commit real keys.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tourismo:tourismo_dev@db:5432/tourismo
# Set all identity variables together when enabling real Google/email sign-in.
# Values from YOUR Clerk application only.
CLERK_ISSUER=https://up-minnow-3748.clerk.accounts.dev
CLERK_JWKS_URL=https://up-minnow-3748.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
ALLOWED_AUTH_ORIGINS=http://localhost:8000,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=pk_test_dXAtbWlubm93LTM3NDguY2xlcmsuYWNjb3VudHMuZGV2JA
# Phone OTP intentionally unavailable (no SMS provider configured).
ENABLE_PHONE_OTP=false
# Render sets PORT automatically; local container uses 8000.
PORT=8000

# Phase 3.2: local Docker development only; private persisted Docker volume.
VENDOR_DOCUMENT_DIR=/app/private_vendor_documents
# Optional ClamAV (clamd) reachable on the Docker network. Without this, uploads remain
# pending_scan and CANNOT be downloaded or counted as clean evidence.
VENDOR_CLAMAV_HOST=
VENDOR_CLAMAV_PORT=3310

# Phase 5.1 maps (production requires an explicitly licensed HTTPS tile URL)
# Public browser tile URL only. Do not include server-side API secrets.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
